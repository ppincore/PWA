{
  "name": "finance-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "prisma:generate": "node -e \"const fs=require('fs'); const path=require('path'); const dir=path.resolve(__dirname,'node_modules/.prisma/client'); if (fs.existsSync(dir)) { for (const file of fs.readdirSync(dir)) { if (file.includes('.tmp') || file.includes('tmp') || file.startsWith('query_engine')) fs.rmSync(path.join(dir, file), { force: true }); } }\" && prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/jwt": "10.0.1",
    "@nestjs/passport": "10.0.1",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/swagger": "7.0.0",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "10.4.15",
    "@types/bcryptjs": "^2.4.1",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
